# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_PASSWORD=synapse_secret
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ── Qdrant ────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=chunks

# ── Runtime Profiles ─────────────────────────────────────────
APP_MODE=local-lite          # local-lite | gpu-demo | test

# ── LLM ──────────────────────────────────────────────────────
LLM_BACKEND=mock             # mock | vllm
OLLAMA_HOST=http://host.docker.internal:11434
VLLM_HOST=http://vllm:8001
LLM_MODEL_OLLAMA=qwen2.5:7b
LLM_MODEL_VLLM=Qwen/Qwen2.5-14B-Instruct-AWQ

# ── Embeddings ────────────────────────────────────────────────
EMBEDDINGS_BACKEND=mock      # mock | local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_HOST=http://host.docker.internal:11434

# ── Storage / Retrieval ───────────────────────────────────────
STORAGE_BACKEND=mock         # mock | qdrant-neo4j

# ── Hybrid Search ─────────────────────────────────────────────
HYBRID_ALPHA=0.7             # вес векторного поиска (1-alpha = граф)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
OCR_TEXT_THRESHOLD=50        # токенов — порог для fallback на OCR

# ── Vision (опционально) ──────────────────────────────────────
VISION_ENABLED=false
VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_ENDPOINT=http://vllm:8002

# ── Observability ─────────────────────────────────────────────
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-changeme
LANGFUSE_SECRET_KEY=sk-lf-changeme
LANGFUSE_DB_PASSWORD=langfuse_secret
LANGFUSE_NEXTAUTH_SECRET=synapse_langfuse_secret_32chars_!!
LANGFUSE_SALT=synapse_salt_changeme_16chars!!!

# ── Grafana ────────────────────────────────────────────────────
GRAFANA_PASSWORD=synapse_grafana

# ── HuggingFace (для загрузки vLLM модели) ────────────────────
HF_TOKEN=

# ── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
